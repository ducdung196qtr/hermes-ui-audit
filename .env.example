# Vercel → private audit controller authentication. Use a long random value.
AUDIT_CONTROLLER_URL=https://audit-worker.example.com
AUDIT_CONTROLLER_TOKEN=replace-with-long-random-secret

# VPS-only 9Router/OpenAI-compatible model configuration.
AI_BASE_URL=http://127.0.0.1:20128/v1
AI_API_KEY=server-only-secret
AI_MODEL=Hermes_Agent

# Safety controls.
AUDIT_ENABLED=true
AUDIT_MAX_QUEUE=3
AUDIT_SCREENSHOT_RETENTION_HOURS=24
AUDIT_REPORT_RETENTION_DAYS=7

# Optional local/demo mode. Never enable publicly.
NEXT_PUBLIC_DEMO_MODE=true
